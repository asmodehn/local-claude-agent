+++ b/dist/credential-rotation.js
@@ -0,0 +1,118 @@
+// Local patch (local-claude-agent): move to the next credential when the current one
+// runs out of quota. Credential `null` is the native one (the CLI login, or an
+// ANTHROPIC_API_KEY already in the agent's environment); after it come the keys of
+// the list file, one per line, `#` starting a comment. A drained key stays drained
+// until the agent process restarts; the native credential comes back once the reset
+// time its limit reported has passed.
+import { appendFileSync, mkdirSync, readFileSync, statSync } from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { isDeniedModel } from "./session-model.js";
+
+const home = os.homedir();
+export const KEYS_FILE = process.env.CLAUDE_ACP_API_KEYS_FILE ??
+    path.join(home, ".config", "claude-agent-acp", "api-keys");
+export const DENIED_MODELS_FILE = process.env.CLAUDE_ACP_DENIED_MODELS_FILE ??
+    path.join(home, ".config", "claude-agent-acp", "denied-models");
+export const LOG_FILE = process.env.CLAUDE_ACP_ROTATION_LOG ??
+    path.join(home, ".local", "state", "claude-agent-acp", "credential-rotation.log");
+
+/** A credential as it may appear in a log or the chat: a key by its last four characters. */
+export function maskKey(key) {
+    return key === null ? "default credential" : `API key ...${key.slice(-4)}`;
+}
+
+/** Appends one JSON line to the rotation log. A log that cannot be written must not
+ *  break the session, so the failure goes to the agent's stderr instead. */
+export function logRotation(event, fields = {}) {
+    const line = JSON.stringify({ time: new Date().toISOString(), event, ...fields });
+    try {
+        mkdirSync(path.dirname(LOG_FILE), { recursive: true });
+        appendFileSync(LOG_FILE, `${line}\n`, { mode: 0o600 });
+    }
+    catch (error) {
+        console.error(`[credential-rotation] cannot write ${LOG_FILE}: ${error}; ${line}`);
+    }
+}
+
+function readKeys() {
+    let text;
+    try {
+        text = readFileSync(KEYS_FILE, "utf8");
+    }
+    catch (error) {
+        logRotation(error?.code === "ENOENT" ? "keys_file_missing" : "keys_file_unreadable", { file: KEYS_FILE, error: String(error) });
+        return [];
+    }
+    if ((statSync(KEYS_FILE).mode & 0o077) !== 0) {
+        logRotation("keys_file_readable_by_others", { file: KEYS_FILE });
+    }
+    return text.split("\n").map((line) => line.replace(/#.*/, "").trim()).filter(Boolean);
+}
+
+/** The model a session on a key of the list must not run, or `undefined`. Entries of the
+ *  denied-models file follow `deniedModels` (`fable` blocks the family); it is read on
+ *  every call, so an edit applies to the next prompt. A missing file denies nothing. */
+export function deniedModelOnKey(session) {
+    if (typeof session.credential !== "string")
+        return undefined;
+    let text;
+    try {
+        text = readFileSync(DENIED_MODELS_FILE, "utf8");
+    }
+    catch (error) {
+        if (error?.code !== "ENOENT")
+            logRotation("denied_models_file_unreadable", { file: DENIED_MODELS_FILE, error: String(error) });
+        return undefined;
+    }
+    const denied = text.split("\n").map((line) => line.replace(/#.*/, "").trim()).filter(Boolean);
+    const modelId = session.models.currentModelId;
+    const resolved = session.modelInfos?.find((info) => info.value === modelId)?.resolvedModel;
+    return [modelId, resolved].find((id) => id && isDeniedModel(id, denied));
+}
+
+class CredentialRotation {
+    current = null;
+    drained = new Set();
+    /** When the native credential's limit resets, in ms, if its limit reported it. */
+    nativeResetsAt = undefined;
+    now = () => Date.now();
+    /** The env a new query needs to use the current credential. */
+    env() {
+        return this.current === null ? {} : { ANTHROPIC_API_KEY: this.current };
+    }
+    /** Records that `failed` ran out of quota and moves to the first credential of the
+     *  list not drained yet. Returns the new credential, or `undefined` when nothing
+     *  changed: `failed` is no longer the current one (another session already moved
+     *  on), or no credential is left. */
+    advance(failed, sessionId, resetsAt) {
+        if (failed !== this.current) {
+            logRotation("quota_exhausted_already_rotated", { sessionId, failed: maskKey(failed), current: maskKey(this.current) });
+            return undefined;
+        }
+        this.drained.add(failed);
+        const next = readKeys().find((key) => !this.drained.has(key));
+        if (next === undefined) {
+            logRotation("no_credential_left", { sessionId, failed: maskKey(failed), file: KEYS_FILE });
+            return undefined;
+        }
+        this.current = next;
+        if (failed === null)
+            this.nativeResetsAt = resetsAt ? resetsAt * 1000 : undefined;
+        logRotation("switched", { sessionId, from: maskKey(failed), to: maskKey(next), ...(failed === null ? { returnsAt: resetsAt ? new Date(resetsAt * 1000).toISOString() : null } : {}) });
+        return next;
+    }
+    /** Moves back to the native credential once its limit has reset. Returns true when
+     *  it moved: the caller then recreates the sessions. */
+    returnIfReset(sessionId) {
+        if (this.current === null || this.nativeResetsAt === undefined || this.now() < this.nativeResetsAt)
+            return false;
+        logRotation("returned", { sessionId, from: maskKey(this.current), to: maskKey(null) });
+        this.drained.delete(null);
+        this.current = null;
+        this.nativeResetsAt = undefined;
+        return true;
+    }
+}
+
+export const credentialRotation = new CredentialRotation();

+/** The model a session on a key of the list must not run, or `undefined`. Entries of the
+ *  denied-models file follow `deniedModels` (`fable` blocks the family); it is read on
+ *  every call, so an edit applies to the next prompt. A missing file denies nothing. */
+export function deniedModelOnKey(session) {
+    if (typeof session.credential !== "string")
+        return undefined;
+    let text;
+    try {
+        text = readFileSync(DENIED_MODELS_FILE, "utf8");
+    }
+    catch (error) {
+        if (error?.code !== "ENOENT")
+            logRotation("denied_models_file_unreadable", { file: DENIED_MODELS_FILE, error: String(error) });
+        return undefined;
+    }
+    const denied = text.split("\n").map((line) => line.replace(/#.*/, "").trim()).filter(Boolean);
+    const modelId = session.models.currentModelId;
+    const resolved = session.modelInfos?.find((info) => info.value === modelId)?.resolvedModel;
+    return [modelId, resolved].find((id) => id && isDeniedModel(id, denied));
+}
